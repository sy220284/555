{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernra/map.schema.json",
  "type": "object",
  "required": ["schema_version","map_id","size_m","playable_bounds","spawn_sectors","resource_nodes","strategic_sites","control_regions","roads","bridges","buildable_polygons","terrain_regions","ai_zones","weather_profile","ruleset_compatibility"],
  "properties": {
    "schema_version": {"const": 4},
    "map_id": {"type":"string","pattern":"^MAP_[A-Z0-9_]+$"},
    "size_m": {"type":"array","items":{"type":"number","exclusiveMinimum":0},"minItems":2,"maxItems":2},
    "playable_bounds": {"type":"array","minItems":3,"items":{"$ref":"#/$defs/point"}},
    "spawn_sectors": {"type":"array","minItems":2,"items":{"$ref":"#/$defs/spawn"}},
    "quickwar_deployment_zones": {"type":"array"},
    "resource_nodes": {"type":"array","items":{"$ref":"#/$defs/resource"}},
    "strategic_sites": {"type":"array","items":{"$ref":"#/$defs/site"}},
    "control_regions": {"type":"array","minItems":3,"items":{"$ref":"#/$defs/region"}},
    "home_core_regions": {"type":"array"},
    "theater_critical_regions": {"type":"array"},
    "roads": {"type":"array"},
    "bridges": {"type":"array"},
    "water_zones": {"type":"array"},
    "buildable_polygons": {"type":"array"},
    "terrain_regions": {"type":"array"},
    "ai_zones": {"type":"array"},
    "weather_profile": {"type":"string"},
    "ruleset_compatibility": {"type":"array","items":{"type":"string","pattern":"^RULESET_[A-Z0-9_]+$"}}
  },
  "$defs": {
    "point": {"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
    "spawn": {
      "type":"object",
      "required":["spawn_id","team_slot","center","facing_deg","safe_radius_m","initial_build_polygon","rally_points"],
      "properties": {
        "spawn_id":{"type":"string"},"team_slot":{"type":"integer","minimum":1},"center":{"$ref":"#/$defs/point"},
        "facing_deg":{"type":"number"},"safe_radius_m":{"type":"number","minimum":600},
        "initial_build_polygon":{"type":"array","items":{"$ref":"#/$defs/point"}},"rally_points":{"type":"array","items":{"$ref":"#/$defs/point"}}
      },"additionalProperties":false
    },
    "resource": {
      "type":"object",
      "required":["node_id","resource_class","mineral_id","grade","position","capacity","base_income_rate","extraction_slots","processing_profile","local_buffer","control_region_id","logistics_links","material_access_tag","contest_weight"],
      "properties": {
        "node_id":{"type":"string"},"resource_class":{"enum":["INDUSTRIAL","STRATEGIC","SALVAGE","DATA","ENERGY","RADAR","AIRFIELD","PORT","LOGISTICS"]},
        "mineral_id":{"type":["string","null"]},"grade":{"enum":["LOW","STANDARD","HIGH"]},"position":{"$ref":"#/$defs/point"},
        "capacity":{"type":"number","minimum":0},"base_income_rate":{"type":"number","minimum":0},"extraction_slots":{"type":"integer","minimum":0},
        "processing_profile":{"type":"string"},"local_buffer":{"type":"number","minimum":0},"control_region_id":{"type":"string"},
        "logistics_links":{"type":"array","items":{"type":"string"}},"material_access_tag":{"type":["string","null"]},"contest_weight":{"type":"number","minimum":0}
      },"additionalProperties":false
    },
    "site": {
      "type":"object","required":["site_id","site_type","position","control_region_id"],
      "properties":{"site_id":{"type":"string"},"site_type":{"type":"string"},"position":{"$ref":"#/$defs/point"},"control_region_id":{"type":"string"},"owner":{"type":"string"}},
      "additionalProperties":true
    },
    "region": {
      "type":"object","required":["region_id","polygon","neighbors","strategic_weight","control_tags","contained_resource_nodes","contained_strategic_sites"],
      "properties":{"region_id":{"type":"string"},"polygon":{"type":"array","items":{"$ref":"#/$defs/point"}},"neighbors":{"type":"array","items":{"type":"string"}},"strategic_weight":{"type":"number","minimum":0},"control_tags":{"type":"array","items":{"type":"string"}},"contained_resource_nodes":{"type":"array","items":{"type":"string"}},"contained_strategic_sites":{"type":"array","items":{"type":"string"}}},
      "additionalProperties":true
    }
  },
  "additionalProperties": true
}
