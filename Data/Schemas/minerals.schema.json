{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernra/minerals.schema.json",
  "type": "object",
  "required": ["schema_version", "minerals"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "minerals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "output_pool", "base_capacity", "base_rate_per_minute", "max_groups"],
        "properties": {
          "id": {"type": "string", "pattern": "^MIN_[A-Z0-9_]+$"},
          "output_pool": {"enum": ["I", "S"]},
          "base_capacity": {"type": "integer", "minimum": 0},
          "base_rate_per_minute": {"type": "number", "minimum": 0},
          "max_groups": {"type": "integer", "minimum": 1},
          "secondary_group_efficiency": {"type": "number", "minimum": 0, "maximum": 1},
          "material_access_tag": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
