{
  "workbenchVersion": "workbench-1.0.0",
  "harness": {
    "version": "0.1.1-rc.2",
    "commit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
    "upstreamRepository": "deepseek-ai/deepseek-harness"
  },
  "completeSource": {
    "path": "workbench-src",
    "layout": "complete-upstream-source-plus-integrated-.workbench",
    "autoSyncWorkflow": ".github/workflows/sync-full-workbench-source.yml",
    "includesWorkbenchModifications": true,
    "excludesGeneratedDependenciesAndCaches": true
  },
  "node": "22.19.0",
  "pnpm": "11.7.0",
  "platform": "linux-x64",
  "releaseTag": "dsh-offline-0.1.1-rc.2",
  "releaseAssets": {
    "deepseek-harness-0.1.1-rc.2-ready-linux-x64.tar.zst": {
      "checksum": "use same-batch SHA256SUMS.txt"
    },
    "dsh-toolchain-linux-x64.tar.zst": {
      "checksum": "use same-batch SHA256SUMS.txt"
    },
    "SHA256SUMS.txt": {
      "role": "checksum manifest for exact workflow/release batch"
    },
    "workbench-overlay-workbench-1.0.0.tar.zst": {
      "role": "portable workbench modification layer"
    }
  },
  "defaultPreset": "chatgpt-takeover",
  "globalSkills": [
    "chatgpt-takeover-ops",
    "repo-review",
    "repo-quality-gate",
    "docs-quality",
    "task-journal"
  ],
  "mcp": {
    "server": "localfs",
    "defaultAllowedRoot": "/mnt/data"
  },
  "lsp": [
    "typescript",
    "javascript",
    "c",
    "cpp"
  ],
  "nativeWebSearch": false,
  "modelCredentialRequiredForTakeoverLocalManagement": false,
  "checksumPolicy": "压缩产物因不同工作流运行的压缩元数据可能产生不同字节哈希；必须使用同一批次 SHA256SUMS.txt 校验，并在解压后再次核对 Harness 版本/提交。"
}
